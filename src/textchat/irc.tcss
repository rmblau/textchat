#chat-input {
    margin: 1;
}

#chat-layout {
    width: 1fr;
    height: 1fr;
}

Dropdown {
    max-width: 32
}

Label {
    width: 1fr;
    height: auto;
}

SettingsScreen {
    align: center top;
}

#settings-form {
    width: 1fr;
    max-width: 72;
    height: 1fr;
    padding: 1 2;
    overflow-y: auto;
}

#profile-actions {
    height: auto;
    margin-top: 1;
}

.settings-title {
    margin-bottom: 1;
    color: $accent;
    text-style: bold;
}

.settings-help {
    margin-bottom: 1;
    color: $text-muted;
}

.settings-label {
    margin-top: 1;
    color: $text-muted;
}

TabbedContent {
    width: 1fr;
    height: 1fr;
    overflow-y: auto;
}

.highlight {
    text-style: bold;
    color: green;
}
Toast {
    padding: 3;
}
#channel-sidebar, #user-sidebar {
    width: 22%;
    min-width: 16;
    max-width: 30;
    height: 100%;
    color: green;
}

#topic-container {
    dock: top;
    width: 1fr;
    height: auto;
    margin-top: 2;
}

#topic-bar {
    width: 1fr;
    height: auto;
    max-height: 5;
    color: $text-muted;
    overflow-y: auto;
}
.italics {
    text-style: italic;
}
QuitScreen {
    align: center middle;
}

WhoisScreen, PrivateMessageScreen, KickedScreen, NetworkPickerScreen {
    align: center middle;
}

#whois-dialog, #private-message-dialog, #kicked-dialog, #network-picker-dialog {
    width: 60;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $background 80%;
    background: $surface;
    content-align: left top;
}

#whois-title, #private-message-title, #kicked-title, #network-picker-title {
    margin-bottom: 1;
    color: $accent;
    text-style: bold;
}

#whois-actions, #private-message-actions, #kicked-actions, #network-picker-actions {
    height: auto;
    margin-top: 1;
}

.whois-error {
    color: $error;
    text-style: bold;
}

.network-choice {
    width: 1fr;
    margin-top: 1;
}

#dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
    background: $surface;
}

#question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}
Button {
    width: 1fr;
}

Vertical {
    content-align: center middle;
}
.column {
    width: 1fr;
}
